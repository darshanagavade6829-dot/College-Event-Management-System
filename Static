:root { --ink: #17243b; --blue: #2457d6; --pale: #edf3ff; }
body { background: #f6f8fc; color: var(--ink); min-height: 100vh; }
.app-nav { background: #14213d; }
.navbar-brand { letter-spacing: .3px; }
.hero { color: white; border-radius: 22px; background: linear-gradient(125deg, #14213d, #2457d6); box-shadow: 0 12px 30px #1e3a8a20; }
.hero p { max-width: 680px; }
.stat-card, .panel, .event-card { border: 1px solid #e5eaf3; border-radius: 16px; background: white; box-shadow: 0 5px 18px #10234b08; }
.stat-card { padding: 20px 22px; display: flex; justify-content: space-between; align-items: center; }
.stat-card span { color: #63718a; font-size: .92rem; }
.stat-card strong { font-size: 1.8rem; color: var(--blue); }
.panel { padding: 24px; }
.event-card { overflow: hidden; transition: transform .15s ease, box-shadow .15s ease; }
.event-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px #10234b12; }
.event-date { display: inline-block; width: fit-content; padding: 6px 10px; border-radius: 999px; background: var(--pale); color: var(--blue); font-size: .82rem; font-weight: 700; }
.btn-primary { background: var(--blue); border-color: var(--blue); }
.form-control, .form-select { border-color: #dce3ef; padding: .68rem .8rem; }
.form-control:focus, .form-select:focus { border-color: #7d9bf0; box-shadow: 0 0 0 .2rem #2457d61a; }
.table thead th { color: #63718a; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
